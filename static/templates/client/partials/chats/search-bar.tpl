<div id="global-chat-search-container" data-plugin="meilisearch" style="padding: 10px; background-color: var(--bs-body-bg); border-bottom: 1px solid var(--bs-border-color); margin-bottom: 5px;">
	<div class="input-group">
		<input type="text" id="global-chat-search" class="form-control" placeholder="{placeholder}" style="font-size: 14px; height: 34px;">
		<span class="input-group-btn">
			<button class="btn btn-primary" id="btn-chat-search" type="button" style="height: 34px;"><i class="fa fa-search"></i></button>
		</span>
	</div>
	<div id="global-search-results" class="chats-list overflow-auto ghost-scrollbar" style="margin-top: 5px; max-height: 400px; display:none;"></div>
</div>
